generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id             String   @id @default(cuid())
  title          String
  summary        String
  author         String
  publishedAt    DateTime
  tags           String[]
  contentPreview String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
