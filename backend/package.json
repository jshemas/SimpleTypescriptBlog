{
  "name": "backend",
  "version": "1.0.0",
  "description": "TypeScript Express backend for SimpleTypescriptBlog",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prepare": "npm run build",
    "test": "tsc -p tsconfig.test.json && mocha \"dist-test/test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "@types/mocha": "^10.0.10",
    "@types/supertest": "^7.2.0",
    "mocha": "^11.7.5",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2"
  }
}
